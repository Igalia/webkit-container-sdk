<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>

  <metamodule id="webkit-deps">
    <dependencies>
      <dep package="dicts"/>
      <dep package="libwpe"/>
      <dep package="wpebackend-fdo"/>
      <dep package="sparkle-cdm"/>
      <dep package="libsoup"/>
      <dep package="openxr"/>
      <dep package="gi-docgen"/>
      <dep package="at-spi2-core"/>
    </dependencies>
  </metamodule>

  <!-- Please use http/https to access repositories to be friendly to users stuck behind firewalls. -->
  <repository type="tarball" name="wpewebkit.org"
      href="https://wpewebkit.org/releases/"/>
  <repository type="tarball" name="download.gnome.org"
      href="https://download.gnome.org/sources/"/>
  <repository type="git" name="freedesktop.org"
      href="https://gitlab.freedesktop.org/"/>
  <repository type="tarball" name="github-tarball"
      href="https://github.com/"/>
  <repository type="git" name="github.com"
      href="https://github.com"/>

  <meson id="sparkle-cdm">
    <branch repo="github.com"
            checkoutdir="sparkle-cdm"
            tag="2026.2"
            module="Sparkle-CDM/sparkle-cdm"/>
  </meson>

  <autotools id="dicts" supports-non-srcdir-builds="no"
             skip-autogen="true">
  <branch repo="github.com"
          checkoutdir="webkitgtk-test-dicts"
          module="mrobinson/webkitgtk-test-dicts.git"
          tag="0.0.1"/>
  </autotools>

  <cmake id="libwpe">
    <branch repo="wpewebkit.org"
            checkoutdir="libwpe"
            module="libwpe-${version}.tar.xz"
            version="1.16.3"
            hash="sha256:c880fa8d607b2aa6eadde7d6d6302b1396ebc38368fe2332fa20e193c7ee1420"/>
  </cmake>

  <meson id="wpebackend-fdo">
    <dependencies>
      <dep package="libwpe"/>
    </dependencies>
    <branch repo="wpewebkit.org"
            checkoutdir="wpebackend-fdo"
            module="wpebackend-fdo-${version}.tar.xz"
            version="1.16.1"
            hash="sha256:544ae14012f8e7e426b8cb522eb0aaaac831ad7c35601d1cf31d37670e0ebb3b">
    </branch>
  </meson>

  <meson id="gi-docgen" mesonargs="-Ddevelopment_tests=false">
    <branch repo="github-tarball"
            checkoutdir="gi-docgen"
            module="GNOME/gi-docgen/archive/14294d53a3d7b07a1a5735fad8eb36206b25fc96.tar.gz"
            rename-tarball="gi-docgen.tar.gz"
            version="2026.2"
            hash="sha256:bc3ef2da7ffb2084fb223736a779626ad4c95715b4308cf7ff38562c6016883f"/>
  </meson>

  <meson id="libsoup" mesonargs="-Dtests=false">
    <branch repo="github.com"
            checkoutdir="libsoup"
            module="GNOME/libsoup.git" tag="3.7.3"/>
  </meson>

  <!-- Ubuntu 26.04 ships at-spi2-core 2.60, which lacks atspi_set_g_main_loop_reentrancy()
       (added in 2.61). The WebKitGTK accessibility API tests drive their own process through
       libatspi, so without it their synchronous calls deadlock. -->
  <meson id="at-spi2-core" mesonargs="-Ddocs=false -Dgtk2_atk_adaptor=false">
    <branch repo="download.gnome.org"
            checkoutdir="at-spi2-core"
            module="at-spi2-core/2.62/at-spi2-core-${version}.tar.xz"
            version="2.62.0"
            hash="sha256:03a94f7bf35f300daf2843a37cdf36479a91bc53f59a8ea437c79e25d95d1de3"/>
  </meson>

  <cmake id="openxr">
    <branch repo="github-tarball"
	    checkoutdir="openxr"
	    module="KhronosGroup/OpenXR-SDK/archive/refs/tags/release-${version}.tar.gz"
	    rename-tarball="OpenXR-SDK-release-${version}.tar.gz"
	    version="1.1.59.1"
	    hash="sha256:f66c1a308a60556c79b723cb0b14bcc51913de8382632ba19af2d5eaf54add50"/>
  </cmake>

</moduleset>
