<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>

  <metamodule id="swift-libs">
    <dependencies>
      <dep package="swift-foundation"/>
      <dep package="swift-driver"/>
      <dep package="swift-format"/>
    </dependencies>
  </metamodule>

  <!-- Please use http/https to access repositories to be friendly to users stuck behind firewalls. -->
  <repository type="tarball" name="github-tarball"
      href="https://github.com/"/>

 <!-- The unified Swift build bootstraps libdispatch without its Swift
       overlay. Rebuild it with the completed compiler so Foundation gets the
       Dispatch module as well as the C runtime. -->
  <cmake
        id="swift-libdispatch"
        cmakeargs="-DCMAKE_BUILD_TYPE=Release
                   -DCMAKE_C_COMPILER=clang
                   -DCMAKE_LINKER_TYPE=LLD
                   -DBUILD_SHARED_LIBS=ON
                   -DENABLE_SWIFT=ON
                   -DBUILD_TESTING=OFF"
  >
    <branch
        repo="github-tarball"
        checkoutdir="swift-libdispatch--corelibs-libdispatch"
        module="swiftlang/swift-corelibs-libdispatch/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
        rename-tarball="swift-corelibs-libdispatch-swift-${version}-RELEASE.tar.gz"
        version="6.3.3"
        hash="sha256:c3a61c08387937622a291e08e64eb4ec0be07f1df252574552641129057951bb"
    >
      <patch file="swift-libdispatch-install-cmake.patch" strip="1"/>
    </branch>
    <dependencies>
      <dep package="swift-toolchain"/>
    </dependencies>
  </cmake>

  <!-- This is built twice, first just for its macros. -->
  <cmake
        id="swift-foundation-macros"
        cmakedir="Sources/FoundationMacros"
        cmakeargs="-DCMAKE_BUILD_TYPE=Release
                   -DCMAKE_LINKER_TYPE=LLD
                   -DFETCHCONTENT_FULLY_DISCONNECTED=ON
                   -DFETCHCONTENT_SOURCE_DIR_SWIFTSYNTAX=${checkoutroot}/swift-foundation--swift-syntax"
  >
    <branch
        repo="github-tarball"
        checkoutdir="swift-foundation"
        module="swiftlang/swift-foundation/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
        rename-tarball="swift-foundation-swift-${version}-RELEASE.tar.gz"
        version="6.3.3"
        hash="sha256:23972ee7ef5e103fa2a9df2704abce787b0f64073fec3df1846c2f2039bf0f3d"
    />
    <branch
            repo="github-tarball"
            checkoutdir="swift-foundation--swift-syntax"
            module="swiftlang/swift-syntax/archive/refs/tags/${version}.tar.gz"
            rename-tarball="swift-syntax-${version}.tar.gz"
            version="603.0.2"
            hash="sha256:4858b54834fae301e36ea63529302d51ce0b4de9da48a465ebab6f6f3d096cf2"
    />
    <dependencies>
      <dep package="swift-toolchain"/>
    </dependencies>
  </cmake>

  <cmake
        id="swift-foundation"
        cmakeargs="-DCMAKE_BUILD_TYPE=Release
                   -DCMAKE_C_COMPILER=clang
                   -DCMAKE_LINKER_TYPE=LLD
                   -DBUILD_SHARED_LIBS=ON
                   -DFOUNDATION_BUILD_TOOLS=OFF
                   -DFOUNDATION_BUILD_NETWORKING=ON
                   -DFETCHCONTENT_FULLY_DISCONNECTED=ON
                   -DFETCHCONTENT_SOURCE_DIR_SWIFTSYNTAX=${checkoutroot}/swift-foundation--swift-syntax
                   -DSwiftFoundation_MACRO=${buildroot}/swift-foundation/lib
                   -D_SwiftFoundation_SourceDIR=${checkoutroot}/swift-foundation
                   -D_SwiftFoundationICU_SourceDIR=${checkoutroot}/swift-foundation-icu
                   -D_SwiftCollections_SourceDIR=${checkoutroot}/swift-foundation--collections"
  >
    <branch
        repo="github-tarball"
        checkoutdir="swift-corelibs-foundation"
        module="swiftlang/swift-corelibs-foundation/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
        rename-tarball="swift-corelibs-foundation-swift-${version}-RELEASE.tar.gz"
        version="6.3.3"
        hash="sha256:cfba08125b15c3138f6d1e2b6cf5058ef2f294f3a08c54ef322d903a5002c20d"
    />
    <branch
        repo="github-tarball"
        checkoutdir="swift-foundation"
        module="swiftlang/swift-foundation/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
        rename-tarball="swift-foundation-swift-${version}-RELEASE.tar.gz"
        version="6.3.3"
        hash="sha256:23972ee7ef5e103fa2a9df2704abce787b0f64073fec3df1846c2f2039bf0f3d"
    />
    <branch
        repo="github-tarball"
        checkoutdir="swift-foundation-icu"
        module="swiftlang/swift-foundation-icu/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
        rename-tarball="swift-foundation-icu-swift-${version}-RELEASE.tar.gz"
        version="6.3.3"
        hash="sha256:3568e41730bce792bb90fbc592ad37df319a62352587ff134a8e554751063cf8"
    />
    <branch
        repo="github-tarball"
        checkoutdir="swift-foundation--collections"
        module="apple/swift-collections/archive/refs/tags/${version}.tar.gz"
        rename-tarball="swift-collections-${version}.tar.gz"
        version="1.1.6"
        hash="sha256:2f558b33b6eba5b0c263110d7cb1a11b59d63059e845dc1984c65359e36f29da"
    />
    <branch
            repo="github-tarball"
            checkoutdir="swift-foundation--swift-syntax"
            module="swiftlang/swift-syntax/archive/refs/tags/${version}.tar.gz"
            rename-tarball="swift-syntax-${version}.tar.gz"
            version="603.0.2"
            hash="sha256:4858b54834fae301e36ea63529302d51ce0b4de9da48a465ebab6f6f3d096cf2"
    />
    <dependencies>
      <dep package="swift-libdispatch"/>
      <dep package="swift-foundation-macros"/>
    </dependencies>
  </cmake>

  <!--
      Most, but not all, cmake projects in Swift assume it is built statically, I went through
      them all and made them shared once, it largely works, but we shouldn't maintain that ourselves.
      So I've tried to respect the defaults of just bundling where it makes sense, I've noted exceptions.

      This sounds nice except that they all continue to install private headers and static libraries that
      we have to remove anyway.

      Since multiple projects bundle the same source I try to avoid conflicts with `checkoutdir` by prefixing
      the module name. This avoids mistakes where you patch it for one module and not another.
  -->

  <!-- Projects like to use this statically except it installs system tools, headers, etc.
       It's actually a shared project, so let's treat it as such. -->
  <cmake id="swift-llbuild"
         cmakeargs="-DCMAKE_BUILD_TYPE=Release
                    -DCMAKE_CXX_COMPILER=clang++
                    -DCMAKE_LINKER_TYPE=LLD
                    -DBUILD_SHARED_LIBS=ON
                    -DBUILD_TESTING=OFF
                    -DLLBUILD_SUPPORT_BINDINGS=Swift">
    <branch repo="github-tarball"
            checkoutdir="swift-llbuild"
            module="swiftlang/swift-llbuild/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
            rename-tarball="swift-llbuild-${version}.tar.gz"
            version="6.3.3"
            hash="sha256:89d9267a1ae741c4d12a58fa3f81a3d07985b5947795eb2edbb41ead373f6a46">
      <patch file="swift-llbuild-install-package.patch" strip="1"/>
      <patch file="swift-llbuild-hide-private-symbols.patch" strip="1"/>
    </branch>
    <dependencies>
      <dep package="swift-foundation"/>
    </dependencies>
  </cmake>

  <cmake id="swift-driver"
         cmakeargs="-DCMAKE_BUILD_TYPE=Release
                    -DCMAKE_CXX_COMPILER=clang++
                    -DCMAKE_LINKER_TYPE=LLD
                    -DBUILD_SHARED_LIBS=OFF
                    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
                    -DFETCHCONTENT_SOURCE_DIR_ARGUMENTPARSER=${checkoutroot}/swift-driver--argument-parser
                    -DFETCHCONTENT_SOURCE_DIR_TOOLSSUPPORTCORE=${checkoutroot}/swift-driver--tools-support-core">
    <branch repo="github-tarball"
            checkoutdir="swift-driver"
            module="swiftlang/swift-driver/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
            rename-tarball="swift-driver-${version}.tar.gz"
            version="6.3.3"
            hash="sha256:d4fcada9b5ad99ed9194b3fae35de234a56d80e833dc19016ac8e904dcc7cd76">
      <patch file="swift-driver-install-rpath.patch" strip="1"/>
      <patch file="swift-driver-exclude-vendored-from-install.patch" strip="1"/>
      <patch file="swift-driver-do-not-install-internal-libraries.patch" strip="1"/>
    </branch>
    <branch repo="github-tarball"
            checkoutdir="swift-driver--argument-parser"
            module="apple/swift-argument-parser/archive/refs/tags/${version}.tar.gz"
            rename-tarball="swift-argument-parser-${version}.tar.gz"
            version="1.6.1"
            hash="sha256:d2fbb15886115bb2d9bfb63d4c1ddd4080cbb4bfef2651335c5d3b9dd5f3c8ba"/>
    <branch repo="github-tarball"
            checkoutdir="swift-driver--tools-support-core"
            module="swiftlang/swift-tools-support-core/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
            rename-tarball="swift-tools-support-core-${version}.tar.gz"
            version="6.3.3"
            hash="sha256:df4dc7e94360d3af711b78d28691df1082faf389d0db78c0ea702e2217a4036f"/>
    <dependencies>
      <dep package="swift-llbuild"/>
    </dependencies>
  </cmake>

  <cmake id="swift-format"
         cmakeargs="-DCMAKE_BUILD_TYPE=Release
                    -DCMAKE_C_COMPILER=clang
                    -DCMAKE_LINKER_TYPE=LLD
                    -DBUILD_SHARED_LIBS=OFF
                    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
                    -DFETCHCONTENT_SOURCE_DIR_ARGUMENTPARSER=${checkoutroot}/swift-format--argument-parser
                    -DFETCHCONTENT_SOURCE_DIR_MARKDOWN=${checkoutroot}/swift-format--markdown
                    -DFETCHCONTENT_SOURCE_DIR_SYNTAX=${checkoutroot}/swift-format--swift-syntax
                    -Dcmark-gfm_DIR=${prefix}/lib/cmake">
    <branch repo="github-tarball"
            checkoutdir="swift-format"
            module="swiftlang/swift-format/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
            rename-tarball="swift-format-${version}.tar.gz"
            version="6.3.3"
            hash="sha256:83f8e638f64f546a98ce92331febaa095f840456123a702fe0bf537634f0dcdd">
      <patch file="swift-format-bundle-dependencies.patch" strip="1"/>
    </branch>
    <branch repo="github-tarball"
            checkoutdir="swift-format--argument-parser"
            module="apple/swift-argument-parser/archive/refs/tags/${version}.tar.gz"
            rename-tarball="swift-argument-parser-${version}.tar.gz"
            version="1.2.3"
            hash="sha256:4a10bbef290a2167c5cc340b39f1f7ff6a8cf4e1b5433b68548bf5f1e542e908"/>
    <branch repo="github-tarball"
            checkoutdir="swift-format--markdown"
            module="swiftlang/swift-markdown/archive/refs/tags/swift-${version}-RELEASE.tar.gz"
            rename-tarball="swift-markdown-${version}.tar.gz"
            version="6.3.3"
            hash="sha256:93684a45e81577a8640292e406c7e645adf9c9e143c59527e833cd49609c98cf"/>
    <branch repo="github-tarball"
            checkoutdir="swift-format--swift-syntax"
            module="swiftlang/swift-syntax/archive/refs/tags/${version}.tar.gz"
            rename-tarball="swift-syntax-${version}.tar.gz"
            version="603.0.2"
            hash="sha256:4858b54834fae301e36ea63529302d51ce0b4de9da48a465ebab6f6f3d096cf2"/>
    <dependencies>
      <dep package="swift-foundation"/>
    </dependencies>
  </cmake>

</moduleset>
